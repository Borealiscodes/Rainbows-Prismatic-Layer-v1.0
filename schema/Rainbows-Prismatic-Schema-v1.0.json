{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rainbows Prismatic Schema v1.0",
  "type": "object",

  "properties": {
    "beam": {
      "type": "object",
      "description": "Non-sovereign conceptual input.",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["id", "label"]
    },

    "spectrum": {
      "type": "object",
      "description": "Prismatic decomposition of the beam.",
      "properties": {
        "hue": { "type": "string" },
        "value": { "type": "number" },
        "chroma": { "type": "number" },
        "gradient": { "type": "string" },
        "refractionAngle": { "type": "number" },
        "scatterPattern": { "type": "string" }
      },
      "required": [
        "hue",
        "value",
        "chroma",
        "gradient",
        "refractionAngle",
        "scatterPattern"
      ]
    },

    "visualGrammar": {
      "type": "object",
      "description": "General prismatic shapes and motions.",
      "properties": {
        "raylines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "spectraBands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "chromaticNodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gradientFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scatterClouds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "recomposition": {
      "type": "object",
      "description": "ND-safe prismatic recomposition.",
      "properties": {
        "diagramType": { "type": "string" },
        "elements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },

  "required": ["beam", "spectrum"]
}
